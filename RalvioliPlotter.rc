// Declares the Windows resources compiled into the RalvioliPlotter executable.
#include <windows.h>
#include "PlotterResource.h"

1 ICON "RalvioliPlotter.ico"
1 24 "RalvioliApp.manifest"

IDD_CALIBRATION DIALOGEX 0, 0, 327, 134
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Paper calibration"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Axis", -1, 8, 9, 70, 10
    LTEXT "Factor", -1, 81, 9, 40, 10
    LTEXT "Expected (mm)", -1, 126, 9, 50, 10
    LTEXT "Measured (mm)", -1, 180, 9, 50, 10
    LTEXT "Paper width (Y)", -1, 8, 25, 70, 11
    LTEXT "", IDC_ACROSS_FACTOR, 81, 25, 43, 11
    EDITTEXT IDC_ACROSS_EXPECTED, 126, 23, 49, 14, ES_AUTOHSCROLL
    EDITTEXT IDC_ACROSS_ACTUAL, 180, 23, 49, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Calculate", IDC_ACROSS_CALCULATE, 234, 23, 40, 14
    PUSHBUTTON "Reset", IDC_ACROSS_RESET, 279, 23, 40, 14
    LTEXT "Paper feed (X)", -1, 8, 46, 70, 11
    LTEXT "", IDC_FEED_FACTOR, 81, 46, 43, 11
    EDITTEXT IDC_FEED_EXPECTED, 126, 44, 49, 14, ES_AUTOHSCROLL
    EDITTEXT IDC_FEED_ACTUAL, 180, 44, 49, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Calculate", IDC_FEED_CALCULATE, 234, 44, 40, 14
    PUSHBUTTON "Reset", IDC_FEED_RESET, 279, 44, 40, 14
    LTEXT "Width (cm)", -1, 8, 71, 45, 11
    EDITTEXT IDC_TEST_RECT_WIDTH, 54, 68, 39, 14, ES_AUTOHSCROLL
    LTEXT "Length (cm)", -1, 99, 71, 48, 11
    EDITTEXT IDC_TEST_RECT_LENGTH, 149, 68, 39, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Print test rectangle", IDC_TEST_RECT_PRINT, 193, 68, 81, 14
    LTEXT "", IDC_TEST_RECT_STATUS, 8, 88, 311, 20
    DEFPUSHBUTTON "Save", IDOK, 225, 111, 45, 14
    PUSHBUTTON "Cancel", IDCANCEL, 274, 111, 45, 14
END

IDD_SERVER_CONFIG DIALOGEX 0, 0, 264, 250
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Paper and drawing", -1, 8, 6, 137, 132
    LTEXT "Right margin (mm)", -1, 16, 22, 80, 12
    EDITTEXT IDC_RIGHT_MARGIN, 100, 20, 36, 14, ES_AUTOHSCROLL
    LTEXT "Drawing spacing (mm)", -1, 16, 44, 80, 12
    EDITTEXT IDC_SPACING, 100, 42, 36, 14, ES_AUTOHSCROLL
    LTEXT "Shift(mm)", -1, 16, 66, 80, 12
    EDITTEXT IDC_SHIFT, 100, 64, 36, 14, ES_AUTOHSCROLL
    LTEXT "Line width (mm)", -1, 16, 88, 80, 12
    EDITTEXT IDC_LINE_WIDTH, 100, 86, 36, 14, ES_AUTOHSCROLL
    LTEXT "Text offset (mm)", -1, 16, 104, 80, 12
    EDITTEXT IDC_TEXT_WIDTH, 100, 102, 36, 14, ES_AUTOHSCROLL
    LTEXT "Label size (%)", -1, 16, 120, 80, 12
    EDITTEXT IDC_LABEL_SIZE, 100, 118, 36, 14, ES_AUTOHSCROLL
    GROUPBOX "Print direction", -1, 151, 6, 105, 39
    AUTORADIOBUTTON "Mono", IDC_MONO, 159, 22, 34, 12, WS_GROUP
    AUTORADIOBUTTON "Bidirectional", IDC_BIDI, 194, 22, 59, 12
    GROUPBOX "Drawing rotation", -1, 151, 51, 105, 63
    AUTORADIOBUTTON "0 degrees", IDC_ROTATE_0, 159, 64, 73, 12, WS_GROUP
    AUTORADIOBUTTON "90 degrees (auto)", IDC_ROTATE_AUTO, 159, 79, 93, 12
    AUTORADIOBUTTON "180 degrees", IDC_ROTATE_180, 159, 94, 79, 12
    GROUPBOX "Print heads and offsets (mm)", -1, 8, 141, 248, 47
    AUTOCHECKBOX "Head 1", IDC_HEAD_1, 16, 154, 50, 11, WS_TABSTOP
    AUTOCHECKBOX "Head 2", IDC_HEAD_2, 76, 154, 50, 11, WS_TABSTOP
    AUTOCHECKBOX "Head 3", IDC_HEAD_3, 136, 154, 50, 11, WS_TABSTOP
    AUTOCHECKBOX "Head 4", IDC_HEAD_4, 196, 154, 50, 11, WS_TABSTOP
    EDITTEXT IDC_HEAD_1_OFFSET, 16, 168, 49, 14, ES_AUTOHSCROLL
    EDITTEXT IDC_HEAD_2_OFFSET, 76, 168, 49, 14, ES_AUTOHSCROLL
    EDITTEXT IDC_HEAD_3_OFFSET, 136, 168, 49, 14, ES_AUTOHSCROLL
    EDITTEXT IDC_HEAD_4_OFFSET, 196, 168, 49, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Calibrate...", IDC_CONFIG_CALIBRATE, 8, 201, 70, 15, WS_GROUP
    PUSHBUTTON "History", IDC_PLOT_HISTORY, 82, 201, 54, 15
    PUSHBUTTON "Test lines", IDC_TEST_LINES, 140, 201, 56, 15
    PUSHBUTTON "Test squares", IDC_TEST_SQUARES, 200, 201, 56, 15
    DEFPUSHBUTTON "Save", IDOK, 145, 226, 52, 15
    PUSHBUTTON "Cancel", IDCANCEL, 204, 226, 52, 15
END
IDR_VEGA_SQUARE RCDATA "VegaSquareRaster.bin"

IDD_PLOT_HISTORY DIALOGEX 0, 0, 320, 181
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Ralvioli print history"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_HISTORY_TEXT, 8, 8, 304, 143, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    DEFPUSHBUTTON "Close", IDCANCEL, 259, 158, 53, 15
END
