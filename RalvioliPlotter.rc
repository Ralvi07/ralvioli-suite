// Declares the Windows resources compiled into the RalvioliPlotter executable.
#include <windows.h>
#include "PlotterResource.h"

1 ICON "RalvioliPlotter.ico"
1 24 "RalvioliApp.manifest"

IDD_CALIBRATION DIALOGEX 0, 0, 282, 119
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Paper calibration"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Axis", -1, 8, 9, 70, 10
    LTEXT "Factor", -1, 81, 9, 40, 10
    LTEXT "Expected (mm)", -1, 126, 9, 50, 10
    LTEXT "Measured (mm)", -1, 180, 9, 50, 10
    LTEXT "Paper feed (X)", -1, 8, 25, 70, 11
    LTEXT "", IDC_FEED_FACTOR, 81, 25, 43, 11
    EDITTEXT IDC_FEED_EXPECTED, 126, 23, 49, 14, ES_AUTOHSCROLL
    EDITTEXT IDC_FEED_ACTUAL, 180, 23, 49, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Calculate", IDC_FEED_CALCULATE, 234, 23, 40, 14
    LTEXT "Across paper (Y)", -1, 8, 46, 70, 11
    LTEXT "", IDC_ACROSS_FACTOR, 81, 46, 43, 11
    EDITTEXT IDC_ACROSS_EXPECTED, 126, 44, 49, 14, ES_AUTOHSCROLL
    EDITTEXT IDC_ACROSS_ACTUAL, 180, 44, 49, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Calculate", IDC_ACROSS_CALCULATE, 234, 44, 40, 14
    LTEXT "Test square side (cm)", -1, 8, 71, 96, 11
    EDITTEXT IDC_TEST_SQUARE_SIZE, 107, 68, 49, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Export test square", IDC_TEST_SQUARE_EXPORT, 162, 68, 87, 14
    PUSHBUTTON "Reset", IDC_CALIBRATION_RESET, 8, 97, 45, 14
    DEFPUSHBUTTON "Save", IDOK, 180, 97, 45, 14
    PUSHBUTTON "Cancel", IDCANCEL, 229, 97, 45, 14
END
